    "@nx/workspace": "19.8.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/react": "14.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "~18.16.9",
    "@types/react": "18.0.28",
    "@types/react-dom": "18.0.11",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.14",
    "babel-jest": "^29.4.1",
    "concurrently": "^9.1.2",
    "cypress": "^12.11.0",
