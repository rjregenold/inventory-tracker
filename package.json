{
  "name": "@gddy-coding-exercise/source",
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=18.0.0"
  },
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "install:nx": "npm install --global nx@latest",
    "setup:db": "tsx scripts/migrate_and_seed_database.js && DATABASE_URL=file:../../../db/gddy.sqlite npx prisma db seed",
    "setup:stream": "tsx scripts/setup-kafka-topics.ts",
    "setup": "npm install && npx prisma generate --schema apps/api/prisma/schema.prisma && npm run setup:db && npm run setup:stream",
    "test": "NODE_ENV=test nx run-many --target=test --all",
    "test:api": "NODE_ENV=test nx test api",
    "test:client": "NODE_ENV=test nx test client",
    "start:api": "nx run api:serve:development",
    "start:client": "nx run client:serve:development",
    "start:consumer": "nx run stream-consumer:serve:development",
    "start": "concurrently \"npm run start:api\" \"npm run start:client\" \"npm run start:consumer\""
  },
  "prisma": {
    "seed": "tsx apps/api/prisma/seed.ts"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/microservices": "^10.4.19",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^4.16.1",
    "axios": "^1.6.0",
    "better-sqlite3": "^11.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.1.0",
    "http-terminator": "^3.2.0",
    "kafkajs": "^2.2.4",
    "nest-commander": "^3.15.0",
    "nestjs-graceful-shutdown": "^1.0.3",
    "next": "14.0.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@nx/cypress": "19.8.0",
    "@nx/eslint-plugin": "19.8.0",
    "@nx/jest": "19.8.0",
    "@nx/js": "19.8.0",
    "@nx/linter": "19.8.0",
    "@nx/nest": "19.8.0",
