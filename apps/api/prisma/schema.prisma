generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Add to your existing schema
model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  userRoles   UserRole[]
  permissions Permission[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  action      String
  resource    String
  roleId      String @map("role_id")
  role        Role   @relation(fields: [roleId], references: [id])

  @@unique([action, resource, roleId])
  @@map("permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  accounts  Account[]
  sessions  Session[]
  userRoles UserRole[]

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime?  @updatedAt @map("updated_at")
  @@map("users")
}

model Item {
  id           Int        @id @default(autoincrement())
  parentItem   ParentItem @relation(fields: [parentItemId], references: [id])
  parentItemId Int        @map("parent_item_id")
  name         String
  sku          String
  price        Decimal
  quantity     Int
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime?  @updatedAt @map("updated_at")

  purchaseOrderLineItems PurchaseOrderLineItem[]

  @@map("items")
}

model ParentItem {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime?  @updatedAt @map("updated_at")

  items Item[]

  @@map("parent_items")
}

model PurchaseOrderLineItem {
  id              Int           @id @default(autoincrement())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId Int           @map("purchase_order_id")
  item            Item          @relation(fields: [itemId], references: [id])
  itemId          Int           @map("item_id")
  quantity        Int
  unitCost        Decimal       @map("unit_cost")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime?     @updatedAt @map("updated_at")

  @@map("purchase_order_line_items")
}

model PurchaseOrder {
  id                   Int       @id @default(autoincrement())
  vendorName           String    @map("vendor_name")
  orderDate            DateTime  @map("order_date")
  expectedDeliveryDate DateTime  @map("expected_delivery_date")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime? @updatedAt @map("updated_at")

  lineItems PurchaseOrderLineItem[]

  @@map("purchase_orders")
}
